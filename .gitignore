# ビルド生成物（Actions が毎回生成するのでコミットしない）
dist/

# ローカル確認用スクリーンショット
.preview/

# APIキー。tools/batch_visibility.py が GEMINI_API_KEY をここから読む。
# 🔴 絶対にコミットしない。公開リポにキーが載ると、課金上限まで使い切られる。
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store

# data/ は追跡する。
# 収集済みニュース600件・論文250件・翻訳の唯一の保管先で、
# ここを失うとアーカイブが復元できない（再収集してもRSSは過去分を返さない）。

# Playwright のブラウザプロファイル（巨大・コミット不可）
tools/note/.chrome-profile/

# Geminiキーを含む引き継ぎメモ（絶対にcommitしない）
HANDOFF_AI可視性チェッカー.md

# IndexNow の送信記録。「どのURLをどの更新日で送ったか」を持ち、
# 次回はその差分だけを通知する。実行機ごとに送信履歴が違うので
# 共有しない——共有すると、別の機械が送った分を「送信済み」と誤認して
# その更新が永久に通知されなくなる。
data/indexnow_sent.json

# 実測レポートの出力（企業ごとの診断結果と送付メール下書き）。
# 相手先の実名・判定・営業文面が入るので公開リポには置かない。
# 元データ(data/visibility/)から gen_company_report.py でいつでも作り直せる。
reports/visibility/

# AEO対策室の日次生成で、検査に落ちた下書き（_aeo_rejected/）と
# --dry-run の確認用出力（_aeo_preview/）。実行機ごとのローカルな作業記録で、
# 公開もしないので共有しない。落ちた理由は日次ログに残る。
content/_aeo_rejected/
content/_aeo_preview/

# サイト内検索の索引。aioni/build.py が毎回 static/ へ書き出す生成物。
# 実行機(mini)と作業機(MBAir)の両方が別々に生成するため、追跡していると
# 毎回 pull で衝突する。2026-08-21、この衝突が index に残ったせいで
# 日次の commit が丸ごと通らず、その日の記事とデータが実行機に
# 取り残された（ジョブ自体は「成功」で終わるので気づけない）。
static/search-*.json

# Neon からの書き戻し検証用（restore_neon.py の既定の出力先）
_restore/
